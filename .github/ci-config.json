{
  "project": "tf-env-isolation-poc",
  "description": "Environment-isolated Terraform: one directory and one S3 state per environment",
  "terraform_version": ">=1.11.0",
  "backend": {
    "type": "s3",
    "note": "No Terraform Cloud. One state key per environment; native S3 lockfiles (use_lockfile)."
  },
  "environments": {
    "dev": {
      "path": "dev",
      "description": "Development environment",
      "state_key": "env/dev/terraform.tfstate"
    },
    "uat": {
      "path": "uat",
      "description": "UAT environment",
      "state_key": "env/uat/terraform.tfstate"
    },
    "prod": {
      "path": "prod",
      "description": "Production environment",
      "state_key": "env/prod/terraform.tfstate"
    }
  }
}
